# Configuration permanente des accès Espace Clinique (#gestion) et PMS SOKHNA OS (/admin)
# Renseignez ces variables dans AI Studio (Settings -> Secrets) ou Vercel (Project Settings -> Environment Variables).
ADMIN_EMAIL=moussa.gaye@pms.com
ADMIN_PASSWORD=

# Clé secrète recommandée en production (Vercel) pour signer les sessions administrateur
SESSION_SECRET=

# Optionnel : comptes individuels supplémentaires en JSON (tableau d'objets {email, password, name, title, role})
# Exemple : [{"email":"idy.kebe@pms.com","password":"...","name":"Dr Idy Kébé","role":"medecin"}]
TEAM_ACCOUNTS_JSON=

# Optionnel (SEO / Référencement Google) : URL publique officielle du site (ex. https://votre-domaine.com)
# Détectée automatiquement sur Vercel si laissée vide.
SITE_URL=

# Optionnel : code de validation HTML Google Search Console (valeur de l'attribut content uniquement)
GOOGLE_SITE_VERIFICATION=
